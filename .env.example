# Copy to .env for explicit local loading only. Replace every placeholder.
# Production and staging must inject settings and secrets through the runtime.
KNOTIC_ENV=development
KNOTIC_LOG_LEVEL=INFO
KNOTIC_DEBUG=false

# Flask backend
KNOTIC_BACKEND_HOST=127.0.0.1
KNOTIC_BACKEND_PORT=8080
KNOTIC_ALLOWED_ORIGINS=["http://localhost:3000"]
KNOTIC_MCP_BASE_URL=http://127.0.0.1:8090
KNOTIC_AGORA_APP_ID=replace-me-with-provider-app-id

# MCP gateway
KNOTIC_MCP_HOST=127.0.0.1
KNOTIC_MCP_PORT=8090
KNOTIC_MCP_ALLOWED_HOSTS=["127.0.0.1"]

# Next.js frontend. Browser-visible (NEXT_PUBLIC_) values only; never place a secret here.
NEXT_PUBLIC_KNOTIC_API_BASE_URL=http://127.0.0.1:8080

# Server-only secrets: never prefix these with NEXT_PUBLIC_ or place them in frontend files.
KNOTIC_DATABASE_URL=postgresql://knotic:replace-me@127.0.0.1:5432/knotic
KNOTIC_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
KNOTIC_MCP_AUTH_TOKEN=replace-me-with-at-least-32-random-characters
KNOTIC_MCP_AUTH_TOKEN_PREVIOUS=
KNOTIC_AGORA_APP_CERTIFICATE=replace-me-with-provider-app-certificate
KNOTIC_SESSION_SECURITY_KEY=replace-me-with-at-least-32-random-characters
KNOTIC_METRICS_AUTH_TOKEN=replace-me-with-at-least-32-random-characters
KNOTIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Model adapter. The API key is server-only; never expose it to the browser.
KNOTIC_OPENAI_API_KEY=replace-me-with-project-scoped-api-key
KNOTIC_OPENAI_MODEL=gpt-5.6-terra
KNOTIC_OPENAI_TIMEOUT_SECONDS=12
