{
  "title": "Knotic Business Integrations",
  "uid": "knotic-integrations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "tags": ["knotic", "integrations", "audit", "slo"],
  "panels": [
    {"id": 1, "title": "Provider action outcomes", "type": "timeseries", "targets": [{"expr": "sum by (tool, status) (rate(knotic_mcp_tool_calls_total{tool=~\"crm.*|calendar.*|followup.*|handoff.*\"}[5m]))", "legendFormat": "{{tool}} / {{status}}"}]},
    {"id": 2, "title": "Pending reconciliation work", "type": "timeseries", "targets": [{"expr": "sum by (kind, status) (knotic_integration_pending_work)", "legendFormat": "{{kind}} / {{status}}"}]},
    {"id": 3, "title": "Webhook rejections", "type": "timeseries", "targets": [{"expr": "sum by (provider, reason) (rate(knotic_integration_webhook_rejections_total[5m]))", "legendFormat": "{{provider}} / {{reason}}"}]},
    {"id": 4, "title": "Provider quota denials", "type": "timeseries", "targets": [{"expr": "sum by (provider) (rate(knotic_integration_provider_quota_denials_total[5m]))", "legendFormat": "{{provider}}"}]},
    {"id": 5, "title": "Provider truth discrepancies", "type": "timeseries", "targets": [{"expr": "sum by (kind) (increase(knotic_integration_discrepancies_total[15m]))", "legendFormat": "{{kind}}"}]},
    {"id": 6, "title": "Integration p95 latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, tool) (rate(knotic_mcp_tool_call_duration_seconds_bucket{tool=~\"crm.*|calendar.*|followup.*|handoff.*\"}[5m])))", "legendFormat": "{{tool}}"}]}
  ]
}
